{
	"name": "devmonowar/janitorix-media-audit",
	"version": "1.0.2",
	"description": "Finds unused images and removes them safely — by proving they are unused first.",
	"type": "wordpress-plugin",
	"keywords": [
		"wordpress",
		"wordpress-plugin",
		"media-library",
		"unused-images",
		"media-cleanup",
		"storage",
		"housekeeping"
	],
	"homepage": "https://wordpress.org/plugins/janitorix-media-audit/",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Monowar Hossain",
			"email": "devmonowar@gmail.com",
			"homepage": "https://devmonowar.github.io/",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/devmonowar/janitorix-media-audit/issues",
		"source": "https://github.com/devmonowar/janitorix-media-audit",
		"forum": "https://wordpress.org/support/plugin/janitorix-media-audit/",
		"docs": "https://devmonowar.github.io/blog/how-to-find-unused-images-in-wordpress/"
	},
	"require": {
		"php": ">=7.4",
		"composer/installers": "^1.0 || ^2.0"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"phpstan/phpstan": "^1.10",
		"szepeviktor/phpstan-wordpress": "^1.3"
	},
	"autoload": {
		"psr-4": {
			"JanitorixMediaAudit\\": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=2G",
		"test": [
			"php tests/invariants.php",
			"php tests/recommendation-grid.php",
			"php tests/risk-engine.php",
			"php tests/confidence-engine.php",
			"php tests/explanation.php",
			"php tests/image-key-hints.php",
			"php tests/dynamic-tags.php",
			"php tests/scan-history.php",
			"php tests/declared-image-fields.php"
		],
		"check": [
			"@test",
			"@analyse",
			"@lint"
		]
	},
	"scripts-descriptions": {
		"test": "Assert the safety invariants hold. Needs no WordPress and no database.",
		"check": "Everything: invariants, static analysis, coding standards.",
		"analyse": "Static analysis. Needs --memory-limit=2G: PHPStan parses the 150k-line WordPress stub file, and its parallel workers each hold their own copy, so a 512M php.ini kills a worker."
	}
}
