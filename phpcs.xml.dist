<?xml version="1.0"?>
<ruleset name="Janitorix Media Audit">
	<description>WordPress Coding Standards for this plugin.</description>

	<file>src</file>
	<file>janitorix-media-audit.php</file>
	<file>uninstall.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<!--
			The plugin queries its own tables and reads WordPress's directly for
			bulk work. Both are deliberate: the scanner layer's entire design
			rests on making ONE pass rather than one query per image, which
			cannot be expressed through the high-level APIs.
		-->
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>

		<!--
			plugin-structure.md is explicit: PSR-4 autoloading, PascalCase.php
			files matching the class name exactly. These two sniffs enforce the
			OPPOSITE — the hyphenated-lowercase, class-prefixed naming of
			old-style procedural WordPress plugins — and would fire on every
			single class in src/.
		-->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>

	</rule>

	<config name="minimum_wp_version" value="6.2"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="janitorix-media-audit"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<!-- The sniff matches case-sensitively; the plugin's constants
				     (JANITORIX_VERSION, JANITORIX_FILE, JANITORIX_PATH) are upper-case. -->
				<element value="JANITORIX"/>
				<element value="janitorix"/>
				<element value="JanitorixMediaAudit"/>
			</property>
		</properties>
	</rule>
</ruleset>
