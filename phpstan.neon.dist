includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5

    # A docblock is a description, not a guarantee. Most of the shapes here
    # come back from $wpdb and from WordPress functions at runtime, so the
    # defensive `?? default` on them is deliberate — treating the PHPDoc as
    # certain turns every one of those guards into a reported error and
    # pushes toward deleting guards to quieten a linter. Five such reports
    # went away with this line, and no code changed.
    treatPhpDocTypesAsCertain: false

    paths:
        - src
        - janitorix-media-audit.php
        - uninstall.php

    bootstrapFiles:
        - tests/phpstan-bootstrap.php

    # These patterns cover known, accepted categories (stub gaps, $wpdb's
    # untyped rows) rather than one specific line, so a given pattern will
    # not always have a live match — that is expected, not a sign one of
    # them has gone stale.
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # CalibrationRun::run() assigns $cleanup inside a `finally`, so it is
        # set on every path that reaches the return — PHPStan is right that
        # the `?? array()` cannot fire. It stays anyway: the finally exists
        # because a failed assertion must never leave fixtures on a live
        # site, and a default on the value it produces is cheap insurance if
        # that block is ever restructured. Scoped to the one file.
        -
            message: '#Variable \$cleanup on left side of \?\? always exists#'
            paths:
                - src/Calibration/CalibrationRun.php

        # Repository methods return stdClass rows from $wpdb, which PHPStan
        # cannot type without a full schema map. The shapes are documented in
        # each method's docblock instead. PHPStan phrases this two ways
        # depending on how the row was narrowed (a direct property access vs.
        # one reached through a `list()` destructure), so both are ignored.
        - '#Cannot access property \$[a-z_]+ on object\|null#'
        - '#Access to an undefined property object::\$[a-z_]+#'

        # WP-CLI is an optional runtime dependency: WP_CLI only exists when
        # the CLI is the one loading the plugin, guarded at the call site by
        # `defined( 'WP_CLI' )`. The wordpress-stubs package this project
        # already depends on does not ship WP-CLI's stubs, and adding a whole
        # second stub package for one optional integration is not worth it.
        # Scoped to the two files that touch WP_CLI, so this cannot hide an
        # unrelated "unknown class" error elsewhere.
        -
            message: '#WP_CLI#'
            paths:
                - src/API/CLI/ScanCommand.php
                - src/Core/Plugin.php

        # wp_get_attachment_metadata() can return an `original_image` key —
        # WordPress 5.3+ adds it for a scaled original — but the stub's
        # return type does not model optional keys, only the ones every
        # image always has. Real, documented WordPress behaviour; a stub gap,
        # not a bug in the code reading it.
        - '#Offset ''original_image'' on array\{.*\} in empty\(\) does not exist#'
        - '#Offset ''original_image'' does not exist on array\{.*\}#'
